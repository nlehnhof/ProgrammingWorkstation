
config defaults '1'
	option syn_flood '1'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option flow_offloading '1'

config zone '2'
	option name 'lan'
	list network 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option masq '1'

config zone '3'
	option name 'wan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'
	option network 'wan wan6'

config forwarding '4'
	option src 'lan'
	option dest 'wan'

config rule '5'
	option name 'Allow-DHCP-Renew'
	option src 'wan'
	list proto 'udp'
	option dest_port '68'
	option target 'ACCEPT'
	option family 'ipv4'
	option priority '1'

config rule '6'
	option name 'Allow-Ping'
	option src 'wan'
	list proto 'icmp'
	option family 'ipv4'
	option priority '2'
	list icmp_type 'echo-request'
	option target 'ACCEPT'
	option enabled '0'

config rule '7'
	option name 'Allow-IGMP'
	option src 'wan'
	list proto 'igmp'
	option family 'ipv4'
	option target 'ACCEPT'
	option priority '3'

config rule '8'
	option name 'Allow-DHCPv6'
	option src 'wan'
	list proto 'udp'
	option src_ip 'fc00::/6'
	option dest_ip 'fc00::/6'
	option dest_port '546'
	option family 'ipv6'
	option target 'ACCEPT'
	option priority '4'

config rule '9'
	option name 'Allow-MLD'
	option src 'wan'
	list proto 'icmp'
	option src_ip 'fe80::/10'
	list icmp_type '130/0'
	list icmp_type '131/0'
	list icmp_type '132/0'
	list icmp_type '143/0'
	option family 'ipv6'
	option target 'ACCEPT'
	option priority '5'

config rule '10'
	option name 'Allow-ICMPv6-Input'
	option src 'wan'
	list proto 'icmp'
	list icmp_type 'echo-request'
	list icmp_type 'echo-reply'
	list icmp_type 'destination-unreachable'
	list icmp_type 'packet-too-big'
	list icmp_type 'time-exceeded'
	list icmp_type 'bad-header'
	list icmp_type 'unknown-header-type'
	list icmp_type 'router-solicitation'
	list icmp_type 'neighbour-solicitation'
	list icmp_type 'router-advertisement'
	list icmp_type 'neighbour-advertisement'
	option limit '1000/sec'
	option family 'ipv6'
	option target 'ACCEPT'
	option priority '6'

config rule '11'
	option name 'Allow-ICMPv6-Forward'
	option src 'wan'
	option dest '*'
	list proto 'icmp'
	list icmp_type 'echo-request'
	list icmp_type 'echo-reply'
	list icmp_type 'destination-unreachable'
	list icmp_type 'packet-too-big'
	list icmp_type 'time-exceeded'
	list icmp_type 'bad-header'
	list icmp_type 'unknown-header-type'
	option limit '1000/sec'
	option family 'ipv6'
	option target 'ACCEPT'
	option priority '7'
	option enabled '0'

config rule '12'
	option name 'Allow-IPSec-ESP'
	option src 'wan'
	option dest 'lan'
	list proto 'esp'
	option target 'ACCEPT'
	option priority '8'

config include '14'
	option path '/etc/firewall.user'

config rule '13'
	option name 'Allow-ISAKMP'
	option src 'wan'
	option dest 'lan'
	option dest_port '500'
	list proto 'udp'
	option target 'ACCEPT'
	option priority '9'

config rule '15'
	option dest_port '22'
	list proto 'tcp'
	option name 'Enable_SSH_WAN'
	option target 'ACCEPT'
	option src 'wan'
	option enabled '0'
	option priority '10'

config rule '16'
	option dest_port '80'
	list proto 'tcp'
	option name 'Enable_HTTP_WAN'
	option target 'ACCEPT'
	option src 'wan'
	option enabled '0'
	option priority '11'

config rule '17'
	option dest_port '443'
	list proto 'tcp'
	option name 'Enable_HTTPS_WAN'
	option target 'ACCEPT'
	option src 'wan'
	option enabled '0'
	option priority '12'

config rule '18'
	option dest_port '4200-4220'
	list proto 'tcp'
	option name 'Enable_CLI_WAN'
	option target 'ACCEPT'
	option src 'wan'
	option enabled '0'
	option priority '13'

config include 'pscan'
	option type 'script'
	option reload '1'
	option path '/usr/bin/attack_prevention'

config rule '19'
	option src_port '5353'
	option src 'lan'
	option name 'Allow-mDNS'
	option target 'ACCEPT'
	list dest_ip '224.0.0.251'
	option dest_port '5353'
	list proto 'udp'
	option priority '14'

config redirect '21'
	option name 'PING_2_PLC'
	option dest 'lan'
	option target 'DNAT'
	list proto 'icmp'
	option src 'wan'
	option dest_ip '192.168.81.7'
	option enabled '1'

config redirect '22'
	option src_dport '502'
	option dest_ip '192.168.81.7'
	option src 'wan'
	option name 'Modbus_2_PLC'
	option dest 'lan'
	option target 'DNAT'
	option enabled '1'
	list proto 'tcp'

config redirect '24'
	option src_dport '44818'
	option dest_ip '192.168.81.7'
	option src 'wan'
	option dest 'lan'
	option target 'DNAT'
	list proto 'tcp'
	list proto 'udp'
	option enabled '1'
	option name 'ENIP_2_PLC'

config redirect '23'
	option enabled '0'
	option src_dport '503'
	option dest_ip '192.168.81.20'
	option dest_port '502'
	option src 'wan'
	option name 'Modbus_2_PCA'
	option dest 'lan'
	option target 'DNAT'
	list proto 'tcp'

config redirect '25'
	option enabled '0'
	option src_dport '22'
	option dest_ip '192.168.81.1'
	option src 'wan'
	option name 'SSH_2_ROUTER'
	option dest 'lan'
	option target 'DNAT'
	list proto 'tcp'

config rule '26'
	option enabled '0'
	option name 'BACnet_2_PBB'
	option target 'ACCEPT'
	option src 'wan'
	list proto 'udp'
	list dest_port '47808'

