
config system 'system'
	option ttylogin '0'
	option urandom_seed '0'
	option device_fw_version 'RUTX_R_00.07.21.3'
	option device_code 'RUTX0800XXXX'
	option devicename 'RUTX08'
	option hostname 'RUTX08'
	option zoneName 'America/Denver'
	option timezone 'MST7MDT,M3.2.0,M11.1.0'

